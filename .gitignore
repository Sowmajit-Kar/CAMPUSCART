# Video Files & Large Media (Do not upload to Git repo)
*.mp4
*.webm
*.mov
*.avi
*.mkv
media/
recordings/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build Outputs & Bundles
dist/
build/
out/
.cache/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

tests
.venv
scratch/
